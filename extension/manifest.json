{
  "manifest_version": 3,
  "name": "CP Intelligent Hint Engine",
  "version": "1.0",
  "description": "Provides non-spoiler hints and bridge problems directly on Codeforces.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/problemset/problem/*",
        "*://codeforces.com/contest/*/problem/*",
        "*://codeforces.com/gym/*/problem/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}